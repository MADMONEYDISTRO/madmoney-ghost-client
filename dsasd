-- Find all MilitaryCrateTIMED crates by looking for "Lid" parts with DEFUSE prompt
-- This matches exactly what the console output showed
local function getCrateList()
    local crates = {}
    local seen   = {}
    for _, obj in pairs(workspace:GetDescendants()) do
        if not isAlive(obj) then continue end
        -- The crate model/folder is the parent of "Lid"
        -- Lid has the ProximityPrompt with ActionText "DEFUSE"
        if obj.Name == "Lid" and obj:IsA("BasePart") then
            local crateModel = obj.Parent
            if crateModel and crateModel.Name == "MilitaryCrateTIMED" and not seen[crateModel] then
                local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt")
                if prompt then
                    seen[crateModel] = true
                    table.insert(crates, {model=crateModel, lid=obj, prompt=prompt})
                    print("[Auth] Found crate: "..crateModel.Name.." Lid@"..tostring(obj.Position))
                end
            end
        end
    end
    -- Sort closest first
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if root then
        local rp = root.Position
        table.sort(crates, function(a,b)
            return (a.lid.Position-rp).Magnitude < (b.lid.Position-rp).Magnitude
        end)
    end
    print("[Auth] Total crates: "..#crates)
    return crates
end

-- After defuse, the second prompt (open lid) may appear on the same Lid or a new child
local function getOpenPrompt(crateModel)
    for _, obj in pairs(crateModel:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and isAlive(obj) then
            local action = obj.ActionText:upper()
            if action:find("OPEN") or action:find("LID") then
                local part = obj.Parent
                if part and part:IsA("BasePart") then
                    return part, obj
                end
            end
        end
    end
    return nil, nil
end

-- Grab all loot that spawned near a crate position after it opens
-- Loot goes into OpenMilitaryCrate or BigLoot
local function grabAuthorityLootNear(cratePos, searchRadius)
    searchRadius = searchRadius or 30
    local grabbed = 0

    -- Helper: fire prompt if part is within radius
    local function tryGrab(part, prompt, label)
        if not isAlive(part) or not isAlive(prompt) then return false end
        local pos = part:IsA("BasePart") and part.Position or getObjPos(part)
        if not pos then return false end
        if (pos - cratePos).Magnitude > searchRadius then return false end
        setAuthStatus("Grabbing: "..label)
        print("[Auth] Grabbing "..label.." dist="..math.floor((pos-cratePos).Magnitude))
        local ok = firePromptOnPart(part, prompt, nil, 2.5)
        if ok then grabbed=grabbed+1; authorityLootGrabbed=authorityLootGrabbed+1; task.wait(0.4) end
        return ok
    end

    -- Scan for loot in OpenMilitaryCrate
    for _, obj in pairs(workspace:GetDescendants()) do
        if not authorityFarmRunning then break end
        if not isAlive(obj) then continue end
        local p = obj.Parent
        if not p then continue end

        if p.Name == "OpenMilitaryCrate" then
            if obj.Name == "DepositMoneyStack" then
                local hitbox = obj:FindFirstChild("Hitbox")
                local grabPart = (hitbox and hitbox:IsA("BasePart")) and hitbox or nil
                if not grabPart then
                    -- find any BasePart with prompt
                    for _, d in pairs(obj:GetDescendants()) do
                        if d:IsA("ProximityPrompt") and d.Parent:IsA("BasePart") then
                            grabPart = d.Parent; break
                        end
                    end
                end
                if grabPart then
                    local prompt = grabPart:FindFirstChildWhichIsA("ProximityPrompt")
                    if prompt then tryGrab(grabPart, prompt, "MoneyStack") end
                end
            elseif obj.Name == "GoldBars" then
                for _, d in pairs(obj:GetDescendants()) do
                    if d:IsA("ProximityPrompt") and isAlive(d) and d.Parent:IsA("BasePart") then
                        tryGrab(d.Parent, d, "GoldBars"); break
                    end
                end
            end
        end

        -- WeaponBagger from BigLoot near crate
        if obj.Name == "Barrel" and obj:IsA("BasePart") and p.Name == "WeaponBagger" then
            local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt")
            if prompt and isAlive(prompt) and (obj.Position-cratePos).Magnitude < searchRadius then
                tryGrab(obj, prompt, "WeaponBagger")
            end
        end

        -- DepositMoneyStack from BigLoot near crate
        if obj.Name == "DepositMoneyStack" and p.Name == "BigLoot" then
            local hitbox = obj:FindFirstChild("Hitbox")
            if hitbox and hitbox:IsA("BasePart") then
                local prompt = hitbox:FindFirstChildWhichIsA("ProximityPrompt")
                if prompt and isAlive(prompt) and (hitbox.Position-cratePos).Magnitude < searchRadius then
                    tryGrab(hitbox, prompt, "MoneyStack(BigLoot)")
                end
            end
        end
    end

    return grabbed
end

local function runAuthorityFarm()
    setAuthStatus("Starting Authority farm...")
    authorityCratesOpened = 0
    authorityLootGrabbed  = 0

    while authorityFarmRunning do
        task.wait(0.2)
        local crateList = getCrateList()

        if #crateList == 0 then
            setAuthStatus("No crates found, waiting...")
            task.wait(5); continue
        end

        local depositedThisLoop = false

        for _, crateData in ipairs(crateList) do
            if not authorityFarmRunning then break end
            local crateModel = crateData.model
            local lid        = crateData.lid
            local defPrompt  = crateData.prompt

            -- Safety: make sure lid/prompt still exist
            if not isAlive(lid) or not isAlive(defPrompt) then
                print("[Auth] Lid/prompt gone, skipping crate"); continue
            end

            local cratePos = lid.Position
            print("[Auth] Processing crate at "..tostring(cratePos))

            -- Move to crate
            setAuthStatus("Moving to crate...")
            tweenTo(CFrame.new(cratePos), 1.5)
            task.wait(0.3)

            -- STEP 1: DEFUSE — snap to Lid, fireproximityprompt
            if isAlive(lid) and isAlive(defPrompt) then
                setAuthStatus("Defusing... (hold=7s)")
                print("[Auth] Defusing Lid at "..tostring(lid.Position))
                firePromptOnPart(lid, defPrompt, 7, 1.5)
                task.wait(1.0)
            else
                print("[Auth] Defuse prompt gone before we could use it"); continue
            end

            -- STEP 2: Wait briefly then look for the OPEN prompt
            setAuthStatus("Waiting for lid open prompt...")
            task.wait(1.5)

            local openPart, openPrompt = nil, nil
            local waitT = tick()
            repeat
                openPart, openPrompt = getOpenPrompt(crateModel)
                if not openPrompt then task.wait(0.3) end
            until openPrompt or tick()-waitT > 6

            if openPart and openPrompt and isAlive(openPart) and isAlive(openPrompt) then
                setAuthStatus("Opening lid...")
                print("[Auth] Opening lid at "..tostring(openPart.Position))
                firePromptOnPart(openPart, openPrompt, openPrompt.HoldDuration, 1.5)
                task.wait(1.0)
            else
                print("[Auth] No open-lid prompt found, crate may already be open")
            end

            -- STEP 3: Wait for loot to spawn
            setAuthStatus("Waiting for loot to spawn...")
            task.wait(2.5)

            -- STEP 4: Grab all loot near this crate
            setAuthStatus("Grabbing loot...")
            local lootGot = grabAuthorityLootNear(cratePos, 30)
            print("[Auth] Grabbed "..lootGot.." items from crate")

            -- Retry once if nothing found (loot may spawn slowly)
            if lootGot == 0 then
                setAuthStatus("No loot yet, waiting and retrying...")
                task.wait(3)
                lootGot = grabAuthorityLootNear(cratePos, 35)
                print("[Auth] Retry grabbed "..lootGot.." items")
            end

            authorityCratesOpened = authorityCratesOpened + 1
            if authorityFarmStatusCallback then
                authorityFarmStatusCallback("Crate "..authorityCratesOpened.." done")
            end

            -- STEP 5: Deposit after EACH crate if we got loot
            if authorityLootGrabbed > 0 then
                setAuthStatus("Depositing at van...")
                tweenTo(AUTH_VAN_CF, 2.5)
                task.wait(0.5)
                pcall(function() RS.RS_Package.Remotes.ThrowBag:FireServer(Vector3.new(-0.37,-0.07,-0.92)) end)
                task.wait(1.0)
                authorityLootGrabbed = 0  -- reset so we deposit again next crate if needed
                depositedThisLoop = true
                setAuthStatus("Deposited. Moving to next crate...")
            end

            task.wait(0.3)
        end

        if not depositedThisLoop then
            setAuthStatus("Loop done, no loot found. Waiting...")
            task.wait(3)
        else
            setAuthStatus("All crates done. Restarting...")
            task.wait(1)
        end
    end

    setAuthStatus("Stopped.")
    restoreCamera(); stopPathLineTracking()
end

