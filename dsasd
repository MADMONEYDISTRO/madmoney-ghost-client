local function tryGrabSafeLoot()
    -- Priority 1: GoldBars (instant, no bag)
    if farmSafeLoot then
        local lootables = workspace:FindFirstChild("Lootables")
        if lootables then
            for _, goldBar in pairs(lootables:GetChildren()) do
                if goldBar.Name == "DepositGoldBar" then
                    local hitbox = goldBar:FindFirstChild("Hitbox")
                    if hitbox and isAlive(hitbox) then
                        local prompt = hitbox:FindFirstChildWhichIsA("ProximityPrompt")
                        if prompt and isAlive(prompt) then
                            setFarmStatus("Grabbing: DepositGoldBar")
                            tweenTo(hitbox.CFrame, 2.5)
                            local ok = firePromptOnPart(hitbox, prompt, 5, 2.5)
                            if ok then task.wait(0.4); return true, false end
                        end
                    end
                end
            end
        end
    end

    -- Priority 2: Cola
    if farmSafeLoot then
        local bigLoot = workspace:FindFirstChild("BigLoot")
        if bigLoot then
            for _, item in pairs(bigLoot:GetChildren()) do
                if not isAlive(item) then continue end
                if item.Name == "Coke" then
                    local cola = item:FindFirstChild("Cola")
                    if cola and isAlive(cola) then
                        local prompt = cola:FindFirstChildWhichIsA("ProximityPrompt")
                        if prompt and isAlive(prompt) then
                            setFarmStatus("Grabbing: Cola")
                            tweenTo(cola.CFrame, 2.0)
                            local ok = firePromptOnPart(cola, prompt, 5, 2.0)
                            if ok then task.wait(0.4); return true, true end
                        end
                    end
                end
            end
        end
    end

    -- Priority 3: DepositMoneyStack
    if farmSafeLoot then
        local bigLoot = workspace:FindFirstChild("BigLoot")
        if bigLoot then
            for _, item in pairs(bigLoot:GetChildren()) do
                if not isAlive(item) then continue end
                if item.Name == "DepositMoneyStack" then
                    local hitbox = item:FindFirstChild("Hitbox")
                    if hitbox and isAlive(hitbox) then
                        local prompt = hitbox:FindFirstChildWhichIsA("ProximityPrompt")
                        if prompt and isAlive(prompt) then
                            setFarmStatus("Grabbing: MoneyStack")
                            tweenTo(hitbox.CFrame, 2.0)
                            local ok = firePromptOnPart(hitbox, prompt, 5, 2.0)
                            if ok then task.wait(0.4); return true, true
                            else setFarmStatus("MoneyStack failed, skipping") end
                        end
                    end
                end
            end
        end
    end

    -- Priority 4: WeaponBagger
    if farmSafeLoot then
        local bigLoot = workspace:FindFirstChild("BigLoot")
        if bigLoot then
            for _, item in pairs(bigLoot:GetChildren()) do
                if not isAlive(item) then continue end
                if item.Name == "WeaponBagger" then
                    local barrel = item:FindFirstChild("Barrel")
                    if barrel and isAlive(barrel) then
                        local prompt = barrel:FindFirstChildWhichIsA("ProximityPrompt")
                            or item:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt and isAlive(prompt) then
                            setFarmStatus("Grabbing: WeaponBagger")
                            tweenTo(barrel.CFrame, 2.8)
                            local ok = firePromptOnPart(barrel, prompt, nil, 2.8)
                            if ok then task.wait(0.4); return true, true end
                        end
                    end
                end
            end
        end
    end

    return false, false
end

local function openCrateAndGrab(cratePrompt)
    if not isAlive(cratePrompt) then return false end
    local crate    = cratePrompt.Parent
    local cratePos = crate.Position
    tweenTo(crate.CFrame, 2.5)
    setFarmStatus("Opening Shadow crate...")
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local hum  = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if root then
        root.CFrame   = CFrame.new(cratePos+Vector3.new(0,2.5,0), cratePos)
        root.Anchored = true
        if hum then hum.PlatformStand=true end
        lookDown()
        pcall(function()
            if type(fireproximityprompt)=="function" then
                fireproximityprompt(cratePrompt)
            else
                cratePrompt:InputHoldBegin()
                task.wait(cratePrompt.HoldDuration+0.5)
                cratePrompt:InputHoldEnd()
            end
        end)
        task.wait(cratePrompt.HoldDuration+0.5)
        local t0=tick(); repeat task.wait(0.1) until not isAlive(cratePrompt) or not cratePrompt.Enabled or tick()-t0>6
        restoreCamera(); root.Anchored=false
        if hum then hum.PlatformStand=false end
    end
    task.wait(1.2)
    local grabbed = false
    local bigLoot = workspace:FindFirstChild("BigLoot")
    if bigLoot then
        for _, item in pairs(bigLoot:GetChildren()) do
            if not farmRunning then return false end
            if not isAlive(item) then continue end
            if item.Name == "DepositMoneyStack" then
                local hitbox = item:FindFirstChild("Hitbox")
                if hitbox and isAlive(hitbox) and (hitbox.Position-cratePos).Magnitude<14 then
                    local prompt = hitbox:FindFirstChildWhichIsA("ProximityPrompt")
                    if prompt and isAlive(prompt) then
                        setFarmStatus("Grabbing: MoneyStack (crate)")
                        firePromptOnPart(hitbox, prompt, 5, 2.0)
                        grabbed=true; break
                    end
                end
            elseif item.Name=="Coke" then
                local cola = item:FindFirstChild("Cola")
                if cola and isAlive(cola) and (cola.Position-cratePos).Magnitude<14 then
                    local prompt = cola:FindFirstChildWhichIsA("ProximityPrompt")
                    if prompt and isAlive(prompt) then
                        setFarmStatus("Grabbing: Cola (crate)")
                        firePromptOnPart(cola, prompt, 5, 2.0)
                        grabbed=true; break
                    end
                end
            elseif item.Name=="WeaponBagger" then
                local barrel = item:FindFirstChild("Barrel")
                if barrel and isAlive(barrel) and (barrel.Position-cratePos).Magnitude<14 then
                    local prompt = barrel:FindFirstChildWhichIsA("ProximityPrompt")
                        or item:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt and isAlive(prompt) then
                        setFarmStatus("Grabbing: WeaponBagger (crate)")
                        firePromptOnPart(barrel, prompt, nil, 2.8)
                        grabbed=true; break
                    end
                end
            end
        end
    end
    return grabbed
end

local function grabCrowbar()
    local crowbarPos = Vector3.new(116.056183, -1.62938297, 160.515045)
    for _, obj in pairs(workspace:GetDescendants()) do
        if not isAlive(obj) then continue end
        if obj:IsA("BasePart") and (obj.Position-crowbarPos).Magnitude<2 then
            local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt")
            if prompt and isAlive(prompt) then
                setFarmStatus("Grabbing crowbar")
                tweenTo(obj.CFrame, 1.5)
                firePromptOnPart(obj, prompt, nil, 1.5)
                task.wait(1); return
            end
        end
    end
    setFarmStatus("Crowbar not found"); task.wait(1)
end

local function runFarm()
    setFarmStatus("Starting farm...")
    pcall(function() RS.RS_Package.Assets.Remotes.MaskOn:FireServer() end)
    while farmRunning do
        task.wait(0.1)
        local hasCrowbar = false
        pcall(function()
            hasCrowbar = player.PlayerGui["SG_Package"]
                .MainGui.PlayerStats.LocalPlayerStats["info_items"]
                .MissionEquipment:FindFirstChild("Crowbar") ~= nil
        end)
        if not hasCrowbar then setFarmStatus("Getting crowbar..."); grabCrowbar(); continue end
        local grabbed, needsDeposit = tryGrabSafeLoot()
        if grabbed then if needsDeposit then depositAtVan() end; continue end
        if farmCrates then
            local shadowBoxes = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("ShadowBoxes")
            if shadowBoxes then
                for _, prompt in pairs(shadowBoxes:GetDescendants()) do
                    if not farmRunning then break end
                    if prompt:IsA("ProximityPrompt") and isAlive(prompt) then
                        local lootGrabbed = openCrateAndGrab(prompt)
                        if lootGrabbed then depositAtVan(); break end
                    end
                end
            end
        end
        setFarmStatus("No loot, waiting..."); task.wait(3)
    end
    setFarmStatus("Stopped."); restoreCamera(); stopPathLineTracking()
end

