local pathLine = Instance.new("Part")
pathLine.Name="FeatherPathLine"; pathLine.Anchored=true
pathLine.CanCollide=false; pathLine.CanQuery=false; pathLine.CanTouch=false
pathLine.CastShadow=false; pathLine.Material=Enum.Material.Neon
