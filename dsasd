local function pulseDot(dot,runningFn)
    task.spawn(function()
        while screenGui and screenGui.Parent do
            if runningFn() then
                TweenService:Create(dot,TweenInfo.new(0.6,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{BackgroundTransparency=0.5}):Play()
                task.wait(0.6)
                TweenService:Create(dot,TweenInfo.new(0.6,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{BackgroundTransparency=0}):Play()
                task.wait(0.6)
            else task.wait(0.5) end
        end
    end)
end

