pathLine.Transparency=1; pathLine.Parent=workspace

local pathLineConn = nil

local function showPathLine(from, to)
    local dist = (to-from).Magnitude
    if dist < 0.1 then pathLine.Transparency=1; return end
    pathLine.Size=Vector3.new(0.12,0.12,dist)
    pathLine.CFrame=CFrame.new(from,to)*CFrame.new(0,0,-dist/2)
    pathLine.Transparency=0.25
end

local function startPathLine(tp)
    if pathLineConn then pathLineConn:Disconnect() end
    pathLineConn = RunService.Heartbeat:Connect(function()
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if root then showPathLine(root.Position, tp) end
    end)
end

local function stopPathLineTracking()
    if pathLineConn then pathLineConn:Disconnect(); pathLineConn=nil end
    pathLine.Transparency=1; pathLine.Size=Vector3.new(0.12,0.12,0.12)
end

