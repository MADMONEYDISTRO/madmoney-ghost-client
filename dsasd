end

local function getPaintingFrontPos(part)
    -- Raycast both sides to find which is open air
    local cf       = part.CFrame
    local pos      = cf.Position
    local lookDir  = cf.LookVector
    local standDist = 4

    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {player.Character, part,
        part.Parent and part.Parent or part}

    local hitFwd = workspace:Raycast(pos,  lookDir * 3, rp)
    local hitBwd = workspace:Raycast(pos, -lookDir * 3, rp)

    local frontDir
    if hitFwd and not hitBwd then
        frontDir = -lookDir
    elseif hitBwd and not hitFwd then
        frontDir = lookDir
    elseif hitFwd and hitBwd then
        frontDir = hitFwd.Distance >= hitBwd.Distance and lookDir or -lookDir
    else
        frontDir = -lookDir -- default: most Notoriety paintings face into wall
    end

    return pos + frontDir * standDist
end

local function getPaintings()
    local paintings = {}
    local seen      = {}
    for _, obj in pairs(workspace:GetDescendants()) do
        if not isAlive(obj) then continue end
        local isPainting = (obj.Name == "LootablePainting")
            or (obj.Parent and obj.Parent.Name == "HIGHLIGHT___")
        if isPainting then
            local part = obj:IsA("BasePart") and obj
                or (obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")))
            if part and not seen[part] then
                -- Find prompt on this object or its descendants
                local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt")
                if not prompt and obj:IsA("Model") then
                    prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                end
                -- Also check parent (HIGHLIGHT___ case)
                if not prompt and obj.Parent then
                    for _, sib in pairs(obj.Parent:GetChildren()) do
                        if sib:IsA("ProximityPrompt") then prompt=sib; break end
                        if sib ~= obj then
                            local pp = sib:FindFirstChildWhichIsA("ProximityPrompt")
                            if pp then prompt=pp; break end
                        end
                    end
                end
                if prompt and isAlive(prompt) then
                    seen[part] = true
                    table.insert(paintings, {part=part, prompt=prompt})
                end
            end
        end
    end
    return paintings
end

local function runGalleryFarm()
    setGalleryStatus("Starting Gallery farm...")
    galleryCratesGrabbed = 0
    galleryLootGrabbed   = 0

    while galleryFarmRunning do
        task.wait(0.2)
        local paintings = getPaintings()

        if #paintings == 0 then
            setGalleryStatus("No paintings found, waiting...")
            task.wait(5); continue
        end

        for _, p in ipairs(paintings) do
            if not galleryFarmRunning then break end
            if not isAlive(p.part) or not isAlive(p.prompt) then
                print("[Gallery] Painting/prompt gone, skipping"); continue
            end

            -- Get the open-air side of the painting
            local standPos = getPaintingFrontPos(p.part)
            local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")

            setGalleryStatus("Teleporting to painting...")
            if root then
                root.CFrame = CFrame.new(standPos, p.part.Position)
            end
            task.wait(0.3)

            setGalleryStatus("Grabbing painting...")
            local ok = firePromptOnPart(p.part, p.prompt, 3, 0)
            -- snapHeight=0 so we don't lift above painting; we already positioned in front

            if ok then
                galleryLootGrabbed = galleryLootGrabbed + 1
                setGalleryStatus("Grabbed! ("..galleryLootGrabbed.." total)")
            else
                -- Try a few offset positions if first attempt fails
                local tried = false
                local offsets = {
                    Vector3.new(2,0,0), Vector3.new(-2,0,0),
                    Vector3.new(0,0,2), Vector3.new(0,0,-2)
                }
                for _, off in ipairs(offsets) do
                    if not isAlive(p.part) or not isAlive(p.prompt) then break end
                    if root then
                        root.CFrame = CFrame.new(standPos+off, p.part.Position)
                    end
                    task.wait(0.2)
                    local ok2 = firePromptOnPart(p.part, p.prompt, 3, 0)
                    if ok2 then
                        galleryLootGrabbed = galleryLootGrabbed + 1
                        setGalleryStatus("Grabbed (offset)! ("..galleryLootGrabbed.." total)")
                        tried = true; break
                    end
                end
                if not tried then
                    setGalleryStatus("Could not grab, skipping")
                end
            end

            -- Deposit at van
            setGalleryStatus("Depositing...")
            if root then
                root.CFrame = CFrame.new(
                    GALLERY_VAN_CF.Position + Vector3.new(0,2.5,0),
                    GALLERY_VAN_CF.Position)
            end
            task.wait(0.5)
            pcall(function() RS.RS_Package.Remotes.ThrowBag:FireServer(Vector3.new(-0.37,-0.07,-0.92)) end)
            task.wait(1)

            galleryCratesGrabbed = galleryCratesGrabbed + 1
            if galleryFarmStatusCallback then
                galleryFarmStatusCallback("Paintings: "..galleryCratesGrabbed.." done")
            end
            task.wait(0.3)
        end

        setGalleryStatus("Restarting loop..."); task.wait(1)
    end

    setGalleryStatus("Stopped.")
    restoreCamera(); stopPathLineTracking()
end

