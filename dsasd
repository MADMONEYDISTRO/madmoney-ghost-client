local ESP_COLORS = {
    KeyCard  = Color3.fromRGB(255, 255, 255),
    Key      = Color3.fromRGB(255, 215,   0),
    Loot     = Color3.fromRGB(  0, 255, 100),
    Citizen  = Color3.fromRGB(  0, 170, 255),
    Guard    = Color3.fromRGB(255,  50,  50),
    Camera   = Color3.fromRGB(170,   0, 255),
    Painting = Color3.fromRGB(255, 128,  64),
}
local espEnabled = {
    KeyCard=false, Key=false, Loot=false,
    Citizen=false, Guard=false, Camera=false, Painting=false,
}
local tracers    = {}
local highlights = {}

local function getESPType(obj)
    local p = obj.Parent
    if obj.Name == "LootablePainting" then return "Painting" end
    if p and p.Name == "HIGHLIGHT___"  then return "Painting" end
    if obj.Name == "KeyCard" then return "KeyCard" end
    if obj.Name == "Key"     then return "Key"     end
    if p then
        if obj.Name == "DepositMoneyStack" and (p.Name=="BigLoot" or p.Name=="OpenMilitaryCrate") then return "Loot" end
        if obj.Name == "GoldBars"          and p.Name == "OpenMilitaryCrate" then return "Loot" end
        if obj.Name == "Cola"   and p.Name == "Coke"      and p.Parent and p.Parent.Name=="BigLoot" then return "Loot" end
        if obj.Name == "Barrel" and p.Name == "WeaponBagger" and p.Parent and p.Parent.Name=="BigLoot" then return "Loot" end
        if obj.Name == "Jewels"            and p.Name == "Lootables" then return "Loot" end
        if obj.Name == "CardboardSafeSpot" and p.Name == "SafeSpots" then return "Loot" end
        if obj.Name == "DepositGoldBar"    and p.Name == "Lootables" then return "Loot" end
        if p.Name == "Citizens" then
            if obj.Name=="Citizen" or obj.Name=="CitizenTied"
            or obj.Name=="CitizenScared" or obj.Name=="CitizenHostage" then return "Citizen" end
        end
        if p.Name=="Police"  and obj.Name=="Guard"  then return "Guard"  end
        if p.Name=="Cameras" and obj.Name=="Camera" then return "Camera" end
    end
    return nil
end

local function getObjPos(obj)
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart.Position end
        local p = obj:FindFirstChildWhichIsA("BasePart")
        if p then return p.Position end
    end
end

local function applyESP(obj)
    local t = getESPType(obj)
    if not t or not espEnabled[t] then return end
    if not highlights[obj] then
        local h = Instance.new("Highlight")
        h.Name="FEATHER_HL"; h.FillColor=ESP_COLORS[t]; h.OutlineColor=ESP_COLORS[t]
        h.FillTransparency=0.45; h.OutlineTransparency=0
        h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
        h.Adornee=obj; h.Parent=obj
        highlights[obj] = h
    end
    if not tracers[obj] then
        local line = Drawing.new("Line")
        line.Color=ESP_COLORS[t]; line.Thickness=1; line.Transparency=0.35; line.Visible=true
        tracers[obj] = {line=line, espType=t}
    end
end

local function removeESP(obj)
    if tracers[obj]    then tracers[obj].line:Remove();   tracers[obj]    = nil end
    if highlights[obj] then highlights[obj]:Destroy();    highlights[obj] = nil end
end

local function setESPCategory(cat, state)
    espEnabled[cat] = state
    for obj, data in pairs(tracers) do
        if data.espType == cat then removeESP(obj) end
    end
    if state then
        for _, v in pairs(workspace:GetDescendants()) do
            if getESPType(v) == cat then applyESP(v) end
        end
    end
end

for _, v in pairs(workspace:GetDescendants()) do applyESP(v) end
workspace.DescendantAdded:Connect(function(v) task.wait(0.1); applyESP(v) end)
workspace.DescendantRemoving:Connect(function(v) removeESP(v) end)

RunService.RenderStepped:Connect(function()
    local size   = Camera.ViewportSize
    local center = Vector2.new(size.X/2, size.Y/2)
    for obj, data in pairs(tracers) do
        if not obj or not obj.Parent then removeESP(obj); continue end
        if not espEnabled[data.espType] then data.line.Visible=false; continue end
        local pos = getObjPos(obj)
        if not pos then data.line.Visible=false; continue end
        local vec = Camera:WorldToViewportPoint(pos)
        local sp  = Vector2.new(vec.X, vec.Y)
        if vec.Z < 0 then sp = center + (center - sp) end
        sp = Vector2.new(math.clamp(sp.X,0,size.X), math.clamp(sp.Y,0,size.Y))
        data.line.From=center; data.line.To=sp; data.line.Visible=true
    end
end)

