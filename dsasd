--  GUARD AVOIDANCE
-- ══════════════════════════════════════════
local function getGuardPositions()
    local guards = {}
    local police = workspace:FindFirstChild("Police")
    if police then
        for _, g in pairs(police:GetChildren()) do
            local r = g:FindFirstChild("HumanoidRootPart") or g:FindFirstChildWhichIsA("BasePart")
            if r then table.insert(guards, r.Position) end
        end
    end
    return guards
end

local function getSafeWaypoint(fromPos, toPos, guards, radius)
    radius = radius or 14
    for _, gPos in ipairs(guards) do
        local dir  = toPos - fromPos
        local len  = dir.Magnitude
        if len < 0.1 then continue end
        local unit = dir/len
        local proj = math.clamp((gPos-fromPos):Dot(unit), 0, len)
        local cl   = fromPos + unit*proj
        if (gPos-cl).Magnitude < radius then
            local perp = Vector3.new(-unit.Z, 0, unit.X)
            if (gPos-cl):Dot(perp) > 0 then perp=-perp end
            return cl + perp*(radius+8)
        end
    end
    return nil
end

local function tweenTo(cf, height)
    height = height or 2.5
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local targetPos = cf.Position + Vector3.new(0, height, 0)
    local guards    = getGuardPositions()
    local wp        = getSafeWaypoint(root.Position, targetPos, guards, 14)
    if wp then
        startPathLine(wp+Vector3.new(0,height,0))
        local t1 = TweenService:Create(root, TweenInfo.new(2.5,Enum.EasingStyle.Linear), {CFrame=CFrame.new(wp+Vector3.new(0,height,0))})
        t1:Play(); t1.Completed:Wait(); stopPathLineTracking(); task.wait(0.1)
    end
    startPathLine(targetPos)
    local t2 = TweenService:Create(root, TweenInfo.new(3,Enum.EasingStyle.Linear), {CFrame=CFrame.new(targetPos)})
    t2:Play(); t2.Completed:Wait()
    root.CFrame = CFrame.new(targetPos, cf.Position)
    stopPathLineTracking()
end

-- ══════════════════════════════════════════
--  CORE PROMPT FIRE
--  Uses fireproximityprompt (confirmed available).
--  Snaps character to promptPart.Position before firing.
--  Guards against nil/destroyed objects.
-- ══════════════════════════════════════════
local function isAlive(obj)
    -- Returns true if obj still exists in the game tree
    if not obj then return false end
    local ok, result = pcall(function() return obj.Parent ~= nil end)
    return ok and result
end

local function firePromptOnPart(promptPart, prompt, holdDuration, snapHeight)
    -- Safety checks
    if not isAlive(promptPart) or not isAlive(prompt) then
        print("[FH] firePromptOnPart: part or prompt gone, skipping")
        return false
    end

    snapHeight = snapHeight or 2.5
    holdDuration = holdDuration or (isAlive(prompt) and prompt.HoldDuration) or 1

    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local hum  = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if not root then return false end

    -- Force prompt accessible
    pcall(function() prompt.MaxActivationDistance = 9999 end)
    pcall(function() prompt.Enabled = true end)

    -- Snap to the prompt's parent part
    local snapPos = promptPart.Position + Vector3.new(0, snapHeight, 0)
    root.CFrame   = CFrame.new(snapPos, promptPart.Position)
    root.Anchored = true
    if hum then hum.PlatformStand = true end
    lookDown()
    task.wait(0.2) -- let server register position

    -- Fire via executor built-in (most reliable, confirmed available)
    local fired = false
    pcall(function()
        if type(fireproximityprompt) == "function" then
            fireproximityprompt(prompt)
            fired = true
        end
    end)

    -- Fallback: InputHoldBegin/End
    if not fired then
        pcall(function() prompt:InputHoldBegin() end)
        task.wait(holdDuration + 0.5)
        pcall(function() prompt:InputHoldEnd() end)
    else
        -- Wait for hold duration regardless
        task.wait(holdDuration + 0.3)
    end

    restoreCamera()
    root.Anchored = false
    if hum then hum.PlatformStand = false end
    task.wait(0.15)
    return true
end

-- Tween close then snap+fire
local function tweenAndFire(targetCF, promptPart, prompt, holdDuration, snapHeight)
    if not isAlive(promptPart) or not isAlive(prompt) then return false end
    tweenTo(targetCF, snapHeight or 2.5)
    return firePromptOnPart(promptPart, prompt, holdDuration, snapHeight)
end

