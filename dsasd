local chLines = {}

local function buildCrosshair()
    for _, l in pairs(chLines) do pcall(function() l:Remove() end) end
    chLines = {}
    local h   = Drawing.new("Line"); h.Thickness=2; h.Color=Color3.new(1,1,1); h.Transparency=1; h.ZIndex=999; h.Visible=false
    local v   = Drawing.new("Line"); v.Thickness=2; v.Color=Color3.new(1,1,1); v.Transparency=1; v.ZIndex=999; v.Visible=false
    local dot = Drawing.new("Circle"); dot.Radius=2; dot.Color=Color3.new(1,1,1); dot.Filled=true; dot.Transparency=1; dot.ZIndex=999; dot.Visible=false
    chLines = {h, v, dot}
    RunService.RenderStepped:Connect(function()
        local vp = Camera.ViewportSize
        local cx, cy, sz = vp.X/2, vp.Y/2, 10
        h.From=Vector2.new(cx-sz,cy); h.To=Vector2.new(cx+sz,cy)
        v.From=Vector2.new(cx,cy-sz); v.To=Vector2.new(cx,cy+sz)
        dot.Position=Vector2.new(cx,cy)
        h.Visible=crosshairEnabled; v.Visible=crosshairEnabled; dot.Visible=crosshairEnabled
    end)
end

local function toggleCrosshair(state)
    crosshairEnabled = state
    for _, l in pairs(chLines) do pcall(function() l.Visible=state end) end
end

