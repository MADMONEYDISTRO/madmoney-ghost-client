-- Counters
local crateCount = 0
local lootCount  = 0

-- Wire up status callback
farmStatusCallback = function(txt)
    farmStatusLbl.Text = "Status:  " .. txt

    -- Animate bar for certain states
    local pct = 0
    if txt:find("Moving") then pct = 0.2
    elseif txt:find("Opening") then pct = 0.45
    elseif txt:find("Scanning") then pct = 0.55
    elseif txt:find("Grabbing") then
        pct = 0.75
        lootCount = lootCount + 1
        farmInfo2.Text = "Loot: " .. lootCount
    elseif txt:find("Depositing") then
        pct = 0.9
        crateCount = crateCount + 1
        farmInfo1.Text = "Crates: " .. crateCount
    elseif txt:find("Stopped") or txt:find("Idle") then
        pct = 0
    end

    TweenService:Create(farmBar, tw(0.4), {Size = UDim2.new(pct, 0, 1, 0)}):Play()
end

farmToggleBtn.MouseButton1Click:Connect(function()
    farmRunning = not farmRunning
    if farmRunning then
        farmToggleBtn.Text             = "⏹  Stop"
        farmToggleBtn.BackgroundColor3 = C.red
        farmDot.BackgroundColor3       = C.green
        crateCount = 0; lootCount = 0
        farmInfo1.Text = "Crates: 0"
        farmInfo2.Text = "Loot: 0"
        notify("Autofarm", "Shadow Raid farm started!", "success")
        task.spawn(runFarm)
    else
        farmToggleBtn.Text             = "▶  Start"
        farmToggleBtn.BackgroundColor3 = C.green
        farmDot.BackgroundColor3       = C.muted
        stopPathLineTracking()
        restoreCamera()
        TweenService:Create(farmBar, tw(0.3), {Size = UDim2.new(0, 0, 1, 0)}):Play()
        notify("Autofarm", "Farm stopped.", "error")
    end
end)

