-- Red path line drawn in world-space showing where the player is heading
local pathLine = Instance.new("Part")
pathLine.Name        = "FeatherPathLine"
pathLine.Anchored    = true
pathLine.CanCollide  = false
pathLine.CanQuery    = false
pathLine.CanTouch    = false
pathLine.CastShadow  = false
pathLine.Material    = Enum.Material.Neon
pathLine.Color       = Color3.fromRGB(255, 40, 40)
pathLine.Size        = Vector3.new(0.12, 0.12, 0.12)
pathLine.Transparency = 1  -- hidden until active
pathLine.Parent      = workspace

local function showPathLine(fromPos, toPos)
    local dist = (toPos - fromPos).Magnitude
    if dist < 0.1 then pathLine.Transparency = 1; return end
    pathLine.Size         = Vector3.new(0.12, 0.12, dist)
    pathLine.CFrame       = CFrame.new(fromPos, toPos) * CFrame.new(0, 0, -dist / 2)
    pathLine.Transparency = 0.25
end

local function hidePathLine()
    pathLine.Transparency = 1
    pathLine.Size = Vector3.new(0.12, 0.12, 0.12)
end

-- Smoothly update path line every frame while moving
local pathLineConnection = nil

local function startPathLineTracking(targetPos)
    if pathLineConnection then pathLineConnection:Disconnect() end
    pathLineConnection = RunService.Heartbeat:Connect(function()
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not root then return end
        showPathLine(root.Position, targetPos)
    end)
end

local function stopPathLineTracking()
    if pathLineConnection then
        pathLineConnection:Disconnect()
        pathLineConnection = nil
    end
    hidePathLine()
end

-- Point camera straight down so proximity prompts always register
local function lookDown()
    pcall(function()
        Camera.CameraType = Enum.CameraType.Scriptable
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if root then
            Camera.CFrame = CFrame.new(root.Position + Vector3.new(0, 8, 0), root.Position)
        end
    end)
end

local function restoreCamera()
    pcall(function()
        Camera.CameraType = Enum.CameraType.Custom
    end)
end

local function tweenTo(cf)
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    setFarmStatus("Moving to target...")

    local targetPos = cf.Position + Vector3.new(0, 5, 0)

    -- Start drawing the red path line live
    startPathLineTracking(targetPos)

    local tween = TweenService:Create(root, TweenInfo.new(3), { CFrame = CFrame.new(targetPos) })
    tween:Play()
    tween.Completed:Wait()

    -- Snap to final position, facing the prompt object
    root.CFrame = CFrame.new(cf.Position + Vector3.new(0, 3, 0), cf.Position)

    stopPathLineTracking()
end

local function holdCrate(prompt)
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local hum  = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    setFarmStatus("Opening crate...")

    -- Snap directly onto crate, facing it
    local cratePos = prompt.Parent.Position
    root.CFrame       = CFrame.new(cratePos + Vector3.new(0, 3, 0), cratePos)
    root.Anchored     = true
    hum.PlatformStand = true

    -- Point camera down so proximity prompt is visible and triggers
    lookDown()

    task.wait(0.5)
    prompt:InputHoldBegin()
    task.wait(prompt.HoldDuration + 0.5)
    prompt:InputHoldEnd()
    repeat task.wait() until not prompt.Enabled

    restoreCamera()
    root.Anchored     = false
    hum.PlatformStand = false
end

local function grabLootInPlace(cratePos)
    local gotLoot = false
    setFarmStatus("Scanning loot...")
    task.wait(1.2)
    local bigLoot = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("ShadowBoxes")
    local lootFolder = workspace:FindFirstChild("BigLoot")
    if lootFolder then
        for _, v in pairs(lootFolder:GetDescendants()) do
            if v:IsA("ProximityPrompt") and v.Parent then
                local part  = v.Parent
                local model = part.Parent
                if part:IsA("BasePart") and model then
                    local dist = (part.Position - cratePos).Magnitude
                    if dist < 10 then
                        local name = model.Name
                        if name == "WeaponBagger" or name == "Coke" or name == "DepositMoneyStack" or name == "GoldBars" or name == "Artifact" then
                            gotLoot = true
                            setFarmStatus("Grabbing: " .. name)
                            local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                            local hum  = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
                            if root and hum then
                                -- Face the loot item
                                root.CFrame   = CFrame.new(root.Position, part.Position)
                                root.Anchored = true
                                hum.PlatformStand = true
                                lookDown()
                                v:InputHoldBegin()
                                task.wait(2.7)
                                v:InputHoldEnd()
                                task.wait(0.3)
                                restoreCamera()
                                root.Anchored = false
                                hum.PlatformStand = false
                            end
                        end
                    end
                end
            end
        end
    end
    return gotLoot
end

local function runFarm()
    setFarmStatus("Starting farm...")
    pcall(function() RS.RS_Package.Assets.Remotes.MaskOn:FireServer() end)

    while farmRunning do
        task.wait(0.1)
        local hasCrowbar = false
        pcall(function()
            hasCrowbar = player.PlayerGui["SG_Package"]
                .MainGui.PlayerStats.LocalPlayerStats["info_items"]
                .MissionEquipment:FindFirstChild("Crowbar") ~= nil
        end)

        if hasCrowbar then
            local shadowBoxes = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("ShadowBoxes")
            if shadowBoxes then
                for _, v in pairs(shadowBoxes:GetDescendants()) do
                    if not farmRunning then break end
                    if v:IsA("ProximityPrompt") then
                        local crate = v.Parent
                        tweenTo(crate.CFrame)
                        holdCrate(v)
                        local gotLoot = grabLootInPlace(crate.Position)
                        if not gotLoot then
                            setFarmStatus("No loot, skipping...")
                        else
                            setFarmStatus("Depositing loot...")
                            tweenTo(CFrame.new(-63, 1, -123))
                            pcall(function()
                                RS.RS_Package.Remotes.ThrowBag:FireServer(Vector3.new(-0.37, -0.07, -0.92))
                            end)
                        end
                        task.wait(0.3)
                    end
                end
            end
        else
            setFarmStatus("Getting crowbar...")
            pcall(function()
                local crowbar = workspace.Map.Crowbars.Crowbar:FindFirstChild("Handle")
                if crowbar then
                    tweenTo(crowbar.CFrame)
                    local prompt = crowbar:FindFirstChildWhichIsA("ProximityPrompt")
                    if prompt then fireproximityprompt(prompt) end
                end
            end)
        end
    end
    setFarmStatus("Stopped.")
end

