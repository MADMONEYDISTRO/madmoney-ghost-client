CopyBtn.MouseButton1Click:Connect(function()
    
    local copied = false

    
    if not copied and type(setclipboard) == "function" then
        pcall(function()
            setclipboard(hwid)
            copied = true
        end)
    end

    
    if not copied and type(toclipboard) == "function" then
        pcall(function()
            toclipboard(hwid)
            copied = true
        end)
    end

    
    if not copied and type(syn) == "table" and type(syn.write_clipboard) == "function" then
        pcall(function()
            syn.write_clipboard(hwid)
            copied = true
        end)
    end

    
    if not copied and type(writeclipboard) == "function" then
        pcall(function()
            writeclipboard(hwid)
            copied = true
        end)
    end

   
    local originalText = CopyBtn.Text
    local originalColor = Color3.fromRGB(70, 80, 200)

    if copied then
        CopyBtn.Text = "Copied to Clipboard!"
        TweenService:Create(CopyBtn, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(40, 160, 90)
        }):Play()
    else
        CopyBtn.Text = "Clipboard API not supported"
        TweenService:Create(CopyBtn, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(180, 120, 30)
        }):Play()
    end

    task.delay(2, function()
        CopyBtn.Text = originalText
        TweenService:Create(CopyBtn, TweenInfo.new(0.3), {
            BackgroundColor3 = originalColor
        }):Play()
    end)
end)



