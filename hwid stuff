local function getHWID()
    local hwid = nil
    local method = "Unknown"

    
    if syn and syn.request then
        pcall(function()
            local r = syn.request({ Url = "http://httpbin.org/get" })
           
        end)
    end

    
    if not hwid and type(gethwid) == "function" then
        pcall(function()
            hwid = gethwid()
            method = "gethwid()"
        end)
    end

    
    if not hwid and type(get_hwid) == "function" then
        pcall(function()
            hwid = get_hwid()
            method = "get_hwid()"
        end)
    end

   
    if not hwid and type(HWID) == "string" then
        hwid = HWID
        method = "HWID (global)"
    end

    
    if not hwid then
        pcall(function()
            if type(identifyexecutor) == "function" then
                local execName = identifyexecutor()
                
                local userId = tostring(Players.LocalPlayer and Players.LocalPlayer.UserId or 0)
                hwid = execName .. "_" .. userId
                method = "identifyexecutor() + UserId"
            end
        end)
    end

 
    if not hwid and type(machineid) == "function" then
        pcall(function()
            hwid = machineid()
            method = "machineid()"
        end)
    end


    if not hwid and type(syn) == "table" and syn.crypt then
        pcall(function()
            local userId = tostring(Players.LocalPlayer.UserId)
            hwid = syn.crypt.hash(userId)
            method = "syn.crypt.hash (fingerprint)"
        end)
    end

    -- Method 8: UserId-based fallback (always works, not true HWID)
    if not hwid then
        local userId = Players.LocalPlayer and tostring(Players.LocalPlayer.UserId) or "0"
        hwid = "FALLBACK_USERID_" .. userId
        method = "UserId Fallback (no executor HWID API found)"
    end

    return hwid, method
end


