-- [Cooldown]
local cooldownLabels = {}
local function TriggerCooldown()
    if State.GlobalCooldown then return false end
    State.GlobalCooldown = true
    task.spawn(function()
        for _, lbl in ipairs(cooldownLabels) do
            if lbl and lbl.Parent then lbl.Text = "WAIT"; lbl.TextColor3 = red end
        end
        task.wait(7)
        for _, lbl in ipairs(cooldownLabels) do
            if lbl and lbl.Parent then lbl.Text = "RUN"; lbl.TextColor3 = Color3.new(1,1,1) end
        end
        State.GlobalCooldown = false
    end)
    return true
end

-- [Get Item]
local function GetClosestTouchGiver()
    local char=Player.Character; if not char then return nil end
    local pos=char.HumanoidRootPart.Position; local closest, sd = nil, math.huge
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name=="TouchGiver" then
            local d=(obj.Position-pos).Magnitude; if d<sd then sd=d; closest=obj end
        end
    end
    return closest
end

local function GetItem(itemName)
    if State.GlobalCooldown then return end
    if not TriggerCooldown() then return end
    local char=Player.Character; if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root=char.HumanoidRootPart; local hum=char:FindFirstChild("Humanoid")
    local origCF=root.CFrame; local origWS=hum.WalkSpeed
    notify("Weapons", "Finding "..itemName, "warning")
    local gf=Workspace:FindFirstChild("Prison_ITEMS") and Workspace.Prison_ITEMS:FindFirstChild("giver")
    local wm=gf and gf:FindFirstChild(itemName)
    if wm then
        hum.WalkSpeed=0
        root.CFrame=CFrame.new(wm:GetPivot().Position)
        task.wait(0.1)
        local tp=GetClosestTouchGiver()
        if tp then
            root.CFrame=tp.CFrame
            firetouchinterest(root, tp, 0); firetouchinterest(root, tp, 1)
            task.wait(0.1)
            root.CFrame=origCF; hum.WalkSpeed=origWS
            notify("Weapons", "Got "..itemName, "success")
        else
            root.CFrame=origCF; hum.WalkSpeed=origWS
            notify("Weapons", "Trigger not found", "error")
        end
    else
        notify("Weapons", itemName.." not found", "error")
    end
end

-- [Remote Arrest]
local function RemoteArrest()
    if State.GlobalCooldown then return end
    local target=State.SelectedArrestTarget
    if not target then notify("Arrest","No target selected","error"); return end
    if not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then notify("Arrest","Target not spawned","error"); return end
    local char=Player.Character; local backpack=Player.Backpack
    local hc=char:FindFirstChild("Handcuffs") or backpack:FindFirstChild("Handcuffs")
    if not hc then notify("Arrest","Switch to Guards first","error"); return end
    if not TriggerCooldown() then return end
    local root=char.HumanoidRootPart; local hum=char:FindFirstChild("Humanoid")
    local origCF=root.CFrame; local origWS=hum.WalkSpeed; local origCam=Camera.CFrame
    notify("Arrest","Arresting "..target.Name,"warning")
    hum.WalkSpeed=0; hum:EquipTool(hc)
    local loop; loop=RunService.RenderStepped:Connect(function()
        if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            Camera.CFrame=CFrame.lookAt(Camera.CFrame.Position, target.Character.HumanoidRootPart.Position)
            root.CFrame=target.Character.HumanoidRootPart.CFrame*CFrame.new(0,0,1.5)
            root.Velocity=Vector3.zero
        end
    end)
    task.wait(0.35)
    local center=Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    VirtualInputManager:SendMouseMoveEvent(center.X, center.Y, game)
    task.wait(0.2)
    VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 1)
