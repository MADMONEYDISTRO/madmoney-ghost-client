local function UpdateESP()
    if not State.ESP_Enabled then return end
    for plr, objs in pairs(State.ESP_Cache) do
        if not plr or not plr.Parent then objs.Box:Destroy(); objs.Billboard:Destroy(); State.ESP_Cache[plr]=nil end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player and p.Character then
            local c=p.Character; local r=c:FindFirstChild("HumanoidRootPart")
            local h=c:FindFirstChild("Head"); local hum=c:FindFirstChild("Humanoid")
            if r and h and hum and hum.Health>0 then
                if not State.ESP_Cache[p] then State.ESP_Cache[p]=CreateESPObjects(p) end
                local o=State.ESP_Cache[p]; local tc=p.TeamColor.Color
                o.Box.Adornee=r; o.Box.Size=Vector3.new(4,5.5,2); o.Box.Color3=tc; o.Box.Visible=true
                o.Billboard.Adornee=h; o.Billboard.Enabled=true
                o.NLabel.Text=p.Name; o.NLabel.TextColor3=tc
                local hp=math.floor((hum.Health/hum.MaxHealth)*100)
                o.HLabel.Text=hp.."%"
                o.HLabel.TextColor3=Color3.fromRGB(255,0,0):Lerp(Color3.fromRGB(0,255,0), hum.Health/hum.MaxHealth)
            elseif State.ESP_Cache[p] then
                State.ESP_Cache[p].Box.Visible=false; State.ESP_Cache[p].Billboard.Enabled=false
            end
        end
    end
end

-- [Aimlock]
local function IsEnemy(p)
    if not p.Team then return true end
    local my = Player.Team and Player.Team.Name; local their = p.Team.Name
    if my==their then return false end
    local function isA(t) return table.find(GCFG.TeamA, t) end
    local function isB(t) return table.find(GCFG.TeamB, t) end
    if isA(my) and isA(their) then return false end
    if isB(my) and isB(their) then return false end
    return true
end

local function IsVisible(tc)
    local mh = Player.Character and Player.Character:FindFirstChild("Head")
    local th = tc:FindFirstChild("Head")
    if not mh or not th then return false end
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {Player.Character, tc}
    params.FilterType = Enum.RaycastFilterType.Blacklist
    local result = Workspace:Raycast(Camera.CFrame.Position, th.Position - Camera.CFrame.Position, params)
    return not (result and result.Instance)
end

local function GetClosestEnemy()
    local closest, dist = nil, math.huge
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player and IsEnemy(p) and p.Character then
            local h=p.Character:FindFirstChild("Head"); local hum=p.Character:FindFirstChild("Humanoid")
            if h and hum and hum.Health>0 then
                local sp, onS = Camera:WorldToViewportPoint(h.Position)
                if onS and IsVisible(p.Character) then
                    local m = (Vector2.new(sp.X,sp.Y)-center).Magnitude
                    if m<dist then dist=m; closest=p.Character end
                end
            end
        end
    end
    return closest
end

local function UpdateAim()
    if not State.Target or not State.Target:FindFirstChild("Humanoid") or State.Target.Humanoid.Health<=0 or not IsVisible(State.Target) then
        State.Aiming=false; State.Target=nil; return
    end
    local h=State.Target:FindFirstChild("Head")
    if h then Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, h.Position), GCFG.AimlockSmoothness) end
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 and State.Aimlock_Enabled then
        State.Target = GetClosestEnemy()
        if State.Target then
            State.Aiming = true
            if not State.AimLoop then State.AimLoop = RunService.RenderStepped:Connect(UpdateAim) end
        end
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        State.Aiming = false
        if State.AimLoop then State.AimLoop:Disconnect(); State.AimLoop = nil end
        State.Target = nil
    end
end)

-- [Fly]
local function ToggleFly(enable)
    local char = Player.Character; if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart
    if enable then
        local bg=Instance.new("BodyGyro",root); bg.P=9e4; bg.maxTorque=Vector3.new(9e9,9e9,9e9); bg.cframe=root.CFrame
        local bv=Instance.new("BodyVelocity",root); bv.velocity=Vector3.zero; bv.maxForce=Vector3.new(9e9,9e9,9e9)
        State.FlyBodyGyro=bg; State.FlyBodyVel=bv
        State.FlyLoop=RunService.RenderStepped:Connect(function()
            if not Player.Character then return end
            Player.Character.Humanoid.PlatformStand=true
            local cf=Camera.CFrame; local v=Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then v=v+cf.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then v=v-cf.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then v=v-cf.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then v=v+cf.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then v=v+Vector3.new(0,1,0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then v=v-Vector3.new(0,1,0) end
            bv.Velocity=v*GCFG.FlySpeed; bg.CFrame=cf
        end)
    else
        if State.FlyLoop then State.FlyLoop:Disconnect() end
        if State.FlyBodyVel then State.FlyBodyVel:Destroy() end
        if State.FlyBodyGyro then State.FlyBodyGyro:Destroy() end
        if char:FindFirstChild("Humanoid") then char.Humanoid.PlatformStand=false end
    end
end

