-- [Teleport]
local function TeleportToTarget()
    if State.GlobalCooldown then return end
    local target=State.SelectedTeleportTarget
    if not target then notify("Teleport","No player selected","error"); return end
    if not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then notify("Teleport","Target not spawned","error"); return end
    if not TriggerCooldown() then return end
    Player.Character.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame * CFrame.new(0,0,3)
    notify("Teleport","Teleported to "..target.Name,"success")
end

