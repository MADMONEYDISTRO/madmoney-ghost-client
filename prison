local function notify(title, msg, nType)
    local col = ({success=green,error=red,warning=gold})[nType] or accent
    local n = Instance.new("Frame")
    n.Size=UDim2.new(0,0,0,50); n.Position=UDim2.new(1,-10,1,-62)
