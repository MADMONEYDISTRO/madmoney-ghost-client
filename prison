    Instance.new("UICorner",n).CornerRadius=UDim.new(0,8)
    local nS=Instance.new("UIStroke",n); nS.Color=T.border; nS.Thickness=1
    local bar=Instance.new("Frame"); bar.Size=UDim2.new(0,3,1,0)
    bar.BackgroundColor3=col; bar.BorderSizePixel=0; bar.Parent=n
    Instance.new("UICorner",bar).CornerRadius=UDim.new(0,8)
    local t1=Instance.new("TextLabel"); t1.Size=UDim2.new(1,-16,0,16); t1.Position=UDim2.new(0,12,0,7)
    t1.Text=title; t1.Font=Enum.Font.GothamBold; t1.TextSize=10
    t1.TextColor3=T.text; t1.TextXAlignment=Enum.TextXAlignment.Left; t1.BackgroundTransparency=1; t1.Parent=n
    local t2=Instance.new("TextLabel"); t2.Size=UDim2.new(1,-16,0,18); t2.Position=UDim2.new(0,12,0,24)
    t2.Text=msg; t2.Font=Enum.Font.Gotham; t2.TextSize=9
    t2.TextColor3=T.text; t2.TextTransparency=0.35; t2.TextXAlignment=Enum.TextXAlignment.Left
    t2.TextWrapped=true; t2.BackgroundTransparency=1; t2.Parent=n
    TweenService:Create(n,tw(0.35,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=UDim2.new(0,260,0,50)}):Play()
    task.delay(2.8,function()
        TweenService:Create(n,tw(),{Size=UDim2.new(0,0,0,50),BackgroundTransparency=1}):Play()
        task.wait(0.3); if n and n.Parent then n:Destroy() end
    end)
end

